# Database Configuration
DB_USER=security_logs_user
DB_PASSWORD=change_this_password
DB_NAME=security_logs
DB_HOST=localhost
DB_PORT=5432

# Application Environment: dev, test, prod
APP_ENV=dev

# Database URLs (constructed from above, or override directly)
# DEV_DATABASE_URL=postgresql://security_logs_user:password@localhost:5432/security_logs
# TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5433/security_logs_test

# pgAdmin (optional)
PGADMIN_EMAIL=admin@localhost.com
PGADMIN_PASSWORD=admin

# Slack Webhook (for CI/CD notifications)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
